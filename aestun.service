[Unit]
Description=aestun - AES-256-GCM obfuscated server-to-server tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aestun -config /etc/aestun/config.json
Restart=always
RestartSec=2
LimitNOFILE=1048576
# CAP_NET_ADMIN: create the TUN device and run ip commands.
# CAP_NET_BIND_SERVICE: bind low ports (e.g. 443).
# CAP_NET_RAW: only used by the optional native desync module (desync.go) to inject
#   TTL-limited fake packets from a raw socket. Harmless to grant when desync is off.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
RuntimeDirectory=aestun
# Gives the DPI observer a place to write that outlives ProtectSystem=full, created with
# the right ownership before the daemon starts.
LogsDirectory=aestun
# Light hardening
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
