[Unit]
Description=aestun - AES-256-GCM obfuscated server-to-server tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aestun -config /etc/aestun/config.json
Restart=always
RestartSec=2
LimitNOFILE=1048576
# Needed to create the TUN device, run ip commands, and bind low ports (e.g. 443):
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
RuntimeDirectory=aestun
# Gives the DPI observer a place to write that outlives ProtectSystem=full, created with
# the right ownership before the daemon starts.
LogsDirectory=aestun
# Light hardening
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
